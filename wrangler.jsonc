{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Cloudflare Workers AI binding — powers real image-classification
  // inference for the /scan flow (see src/lib/ai.ts). Available
  // automatically once deployed to Cloudflare; requires no extra secrets.
  "ai": {
    "binding": "AI"
  }

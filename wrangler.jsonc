{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Cloudflare Workers AI binding — powers real image-classification
  // inference for the /scan flow (see backend/src/services/ai.ts).
  // Available automatically once deployed to Cloudflare; requires no
  // extra secrets.
  "ai": {
    "binding": "AI"
  },
  // Cloudflare D1 — primary relational store for Crop Rakshak (users, crops,
  // diagnoses, risk assessments, recommendations, follow-ups, feedback,
  // expert reviews, alerts, seed verification, regional reports, dealers).
  // See database/migrations/ for schema and docs/database.md for details.
  // database_id below is a placeholder for local development; the deploy
  // flow replaces it with the real UUID returned by `wrangler d1 create`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "database/migrations"
    }
  ]
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ]
}